{
  "model_name": "Temporal LSTM World Model (Primary Architecture)",
  "checkpoint_file": "lstm_world_model.pt",
  "scaler_file": "scaler.joblib",
  "dataset": "CSE-CIC-IDS2018 (Friday-02-03-2018)",
  "feature_dimension": 23,
  "sequence_length": 10,
  "forecast_horizon": 5,
  "window_seconds": 5.0,
  "architecture": {
    "type": "TemporalLSTMWorldModel",
    "input_size": 23,
    "hidden_size": 128,
    "num_layers": 2,
    "dropout": 0.2,
    "num_stages": 6
  },
  "training": {
    "seed": 42,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "loss_weights": {
      "state_prediction": 1.0,
      "attack_prob": 0.5,
      "stage_class": 0.5
    }
  },
  "benchmark_script": "training/run_strict_leakage_free_benchmark.py"
}